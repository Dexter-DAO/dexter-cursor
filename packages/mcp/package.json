{
  "name": "@dexterai/opendexter",
  "version": "1.23.0",
  "description": "Local OpenDexter MCP for x402 discovery, current terms, explicitly prepared purchase modes, local wallet reads, and linked governed portfolio reads.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "opendexter": "dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "skills",
    "rules",
    "agents",
    "commands",
    ".cursor-plugin",
    "cursor-mcp.json"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-widgets.mjs",
    "dev": "tsx src/index.ts",
    "pack:verify": "node ./verify-pack-no-sourcemaps.mjs",
    "prepack": "npm run version:check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "version": "npm run version:sync",
    "version:check": "node scripts/sync-version-references.mjs --check",
    "version:sync": "node scripts/sync-version-references.mjs",
    "prepublishOnly": "node scripts/publish-release-candidate.mjs",
    "release": "node scripts/refuse-direct-release.mjs",
    "release:hosted-source": "node scripts/verify-hosted-source.mjs",
    "release:prepare-hosted": "node scripts/public-hosted-release.mjs prepare",
    "inspect:tarball": "bash scripts/inspect-package-tarball.sh",
    "test:fresh-install": "bash scripts/test-registry-install.sh"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@dexterai/dextercard": "0.5.0",
    "@dexterai/mcp-instructions": "2.4.0",
    "@dexterai/vault": "0.43.0",
    "@dexterai/x402": "5.4.2",
    "@dexterai/x402-core": "1.5.1",
    "@dexterai/x402-mcp-tools": "0.8.1",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "@x402/core": "2.19.0",
    "@x402/extensions": "2.19.0",
    "bs58": "6.0.0",
    "chalk": "5.6.2",
    "ethers": "6.17.0",
    "qrcode-terminal": "0.12.0",
    "tweetnacl": "1.0.3",
    "viem": "2.55.8",
    "yargs": "17.7.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/qrcode-terminal": "0.12.2",
    "@types/yargs": "17.0.35",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "provenance": true
  },
  "keywords": [
    "opendexter",
    "x402",
    "mcp",
    "dexter",
    "solana",
    "base",
    "evm",
    "payments",
    "ai-agents",
    "marketplace",
    "chatgpt",
    "cursor",
    "claude"
  ],
  "author": "Dexter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dexter-DAO/opendexter-ide",
    "directory": "packages/mcp"
  },
  "homepage": "https://dexter.cash/opendexter"
}

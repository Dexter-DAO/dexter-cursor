{
  "schemaVersion": 1,
  "kind": "opendexter-novice-routing-cases/v1",
  "cases": [
    {
      "id": "hosted-discover-service",
      "surface": "hosted-connected",
      "prompt": "Can you find a reliable API that gives me the current weather in Tokyo?",
      "requiredTools": ["indexter_search"],
      "forbiddenTools": ["x402_fetch"],
      "expectedConsequence": "inert-read"
    },
    {
      "id": "hosted-check-known-endpoint",
      "surface": "hosted-connected",
      "prompt": "Before I spend anything, tell me the current price and terms for calling https://seller.example/report.",
      "requiredTools": ["x402_check"],
      "forbiddenTools": ["x402_fetch"],
      "expectedConsequence": "durable-quote-intent"
    },
    {
      "id": "hosted-non-get-check-waits-for-confirmation",
      "surface": "hosted-connected",
      "prompt": "Show me what it would cost to post this report request to the provider, but first explain whether checking could submit it and wait for me to confirm.",
      "requiredTools": [],
      "forbiddenTools": [
        "x402_check",
        "x402_fetch"
      ],
      "expectedConsequence": "confirmation-required"
    },
    {
      "id": "hosted-complete-approved-purchase",
      "surface": "hosted-connected",
      "prompt": "The price you just showed me is okay. Go ahead with that exact report, but do not charge more than the amount I approved.",
      "requiredTools": ["x402_fetch"],
      "forbiddenTools": [],
      "expectedConsequence": "single-approved-execution"
    },
    {
      "id": "hosted-ambiguous-purchase",
      "surface": "hosted-connected",
      "prompt": "That purchase timed out and I cannot tell whether it went through. Please find out without buying it again.",
      "requiredTools": ["x402_status"],
      "forbiddenTools": ["x402_fetch"],
      "expectedConsequence": "inert-read"
    },
    {
      "id": "hosted-wallet-summary",
      "surface": "hosted-connected",
      "prompt": "How much money is in my Dexter wallet, and what address should I use to add funds?",
      "requiredTools": ["dexter_wallet"],
      "forbiddenTools": [],
      "expectedConsequence": "inert-read"
    },
    {
      "id": "hosted-wallet-presence-vague",
      "surface": "hosted-connected",
      "prompt": "Do I have a Dexter Wallet?",
      "requiredTools": ["dexter_wallet"],
      "forbiddenTools": [],
      "expectedConsequence": "connect-or-wallet-read"
    },
    {
      "id": "hosted-wallet-summary-vague",
      "surface": "hosted-connected",
      "prompt": "What is in my wallet right now?",
      "requiredTools": ["dexter_wallet", "dexter_wallet_portfolio"],
      "forbiddenTools": [],
      "expectedConsequence": "inert-read"
    },
    {
      "id": "hosted-payment-missing-target",
      "surface": "hosted-connected",
      "prompt": "Please pay for this API for me.",
      "requiredTools": [],
      "forbiddenTools": ["x402_fetch"],
      "expectedConsequence": "clarification"
    },
    {
      "id": "hosted-wallet-proof-access",
      "surface": "hosted-connected",
      "prompt": "Use my wallet proof to sign me into the read-only member page we were discussing. This is not a payment.",
      "requiredTools": ["x402_access"],
      "forbiddenTools": [
        "x402_check",
        "x402_fetch"
      ],
      "expectedConsequence": "external-wallet-proof-request"
    },
    {
      "id": "hosted-mutating-access-waits-for-confirmation",
      "surface": "hosted-connected",
      "prompt": "Sign me into that provider with the post request, but explain whether it could change anything there and wait for me to confirm before sending it.",
      "requiredTools": [],
      "forbiddenTools": [
        "x402_access",
        "x402_check",
        "x402_fetch"
      ],
      "expectedConsequence": "confirmation-required"
    },
    {
      "id": "different-wallet-does-not-route",
      "surface": "hosted-connected",
      "prompt": "What is in my Phantom wallet right now?",
      "requiredTools": [],
      "forbiddenTools": ["dexter_wallet"],
      "expectedConsequence": "not-opendexter"
    },
    {
      "id": "hosted-buy-ordinary-language",
      "surface": "hosted-connected",
      "prompt": "Use twenty-five dollars from my wallet to buy the supported asset we were discussing. If my standing permission covers it, complete it and tell me what actually happened.",
      "requiredTools": [
        "dexter_wallet_portfolio",
        "dexter_prepare_asset_action",
        "dexter_execute_asset_action"
      ],
      "forbiddenTools": ["dexter_reconcile_asset_action"],
      "expectedConsequence": "governed-action"
    },
    {
      "id": "hosted-approval-escalation",
      "surface": "hosted-connected",
      "prompt": "Sell half of that holding. If my current permission is not enough, explain what I need to approve instead of finding a workaround.",
      "requiredTools": ["dexter_wallet_portfolio", "dexter_prepare_asset_action"],
      "forbiddenTools": ["dexter_execute_asset_action"],
      "expectedConsequence": "owner-approval-handoff"
    },
    {
      "id": "hosted-send-currently-unavailable",
      "surface": "hosted-connected",
      "prompt": "Send five USDC from my Dexter wallet to the recipient we just discussed. If sending is not currently available, tell me why and stop instead of trying another kind of transaction.",
      "requiredTools": [
        "dexter_wallet_portfolio",
        "dexter_prepare_asset_action"
      ],
      "forbiddenTools": [
        "dexter_execute_asset_action",
        "dexter_asset_action_status",
        "dexter_reconcile_asset_action"
      ],
      "expectedConsequence": "runtime-unavailable"
    },
    {
      "id": "hosted-governed-uncertainty",
      "surface": "hosted-connected",
      "prompt": "The trade is still unclear after the timeout. Check the same transaction and recover it only if the system says recovery is needed. Do not place another trade.",
      "requiredTools": [
        "dexter_asset_action_status",
        "dexter_reconcile_asset_action"
      ],
      "forbiddenTools": ["dexter_execute_asset_action"],
      "expectedConsequence": "same-intent-reconciliation"
    },
    {
      "id": "hosted-reconciliation-is-status-gated",
      "surface": "hosted-connected",
      "prompt": "Check the same uncertain wallet action. If the durable status does not explicitly say recovery is required, stop and do not try to execute or recover it.",
      "requiredTools": ["dexter_asset_action_status"],
      "forbiddenTools": [
        "dexter_execute_asset_action",
        "dexter_reconcile_asset_action"
      ],
      "expectedConsequence": "conditional-status-read"
    },
    {
      "id": "hosted-action-history",
      "surface": "hosted-connected",
      "prompt": "Show me my recent wallet trades and transfers, including anything that is still pending or failed.",
      "requiredTools": ["dexter_wallet_history"],
      "forbiddenTools": [],
      "expectedConsequence": "inert-read"
    },
    {
      "id": "local-wallet-boundary",
      "surface": "local",
      "prompt": "What can the wallet on this computer spend right now? Do not use my hosted account balance as permission.",
      "requiredTools": ["x402_wallet"],
      "forbiddenTools": ["dexter_prepare_asset_action"],
      "expectedConsequence": "inert-read"
    }
  ]
}
